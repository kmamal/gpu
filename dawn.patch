@@ -0,0 +1,64 @@
+#include <cstdint>
+
+#include "src/utils/platform.h"
+#include "webgpu/webgpu_sdl.h"
+
+namespace wgpu::sdl {
+
+#if DAWN_PLATFORM_IS(WINDOWS)
+    struct NativeData {
+        void* hwnd;
+        void* hinstance;
+    };
+#elif defined(DAWN_ENABLE_BACKEND_METAL)
+    struct NativeData {
+        void* layer;
+    };
+#else
+    // Tagged payload shared with @kmamal/sdl (see sdl's window.native docs)
+    struct NativeData {
+        uint64_t subsystem;  // 1 = x11, 2 = wayland
+        void* display;       // Display* | wl_display*
+        uintptr_t window;    // Window XID | wl_surface*
+    };
+#endif
+
+wgpu::Surface CreateSurfaceForWindow(const wgpu::Instance& instance, void* nativeData) {
+    NativeData* native = static_cast<NativeData*>(nativeData);
+    wgpu::SurfaceDescriptor descriptor;
+
+#if DAWN_PLATFORM_IS(WINDOWS)
+    wgpu::SurfaceSourceWindowsHWND source;
+    source.hwnd = native->hwnd;
+    source.hinstance = native->hinstance;
+    descriptor.nextInChain = &source;
+    return instance.CreateSurface(&descriptor);
+#elif defined(DAWN_ENABLE_BACKEND_METAL)
+    wgpu::SurfaceSourceMetalLayer source;
+    source.layer = native->layer;
+    descriptor.nextInChain = &source;
+    return instance.CreateSurface(&descriptor);
+#else
+#if defined(DAWN_USE_X11)
+    if (native->subsystem == 1) {
+        wgpu::SurfaceSourceXlibWindow source;
+        source.display = native->display;
+        source.window = native->window;
+        descriptor.nextInChain = &source;
+        return instance.CreateSurface(&descriptor);
+    }
+#endif
+#if defined(DAWN_USE_WAYLAND)
+    if (native->subsystem == 2) {
+        wgpu::SurfaceSourceWaylandSurface source;
+        source.display = native->display;
+        source.surface = reinterpret_cast<void*>(native->window);
+        descriptor.nextInChain = &source;
+        return instance.CreateSurface(&descriptor);
+    }
+#endif
+    return instance.CreateSurface(&descriptor);
+#endif
+}
