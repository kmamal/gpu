+class Renderer : public Napi::ObjectWrap<Renderer> {
+
+public:
+
+    static Napi::Function Class(const Napi::Env &env) {
+        return DefineClass(env, "Renderer", {
+            InstanceMethod("getPreferredFormat", &Renderer::getPreferredFormat),
+            InstanceMethod("getCurrentTexture", &Renderer::getCurrentTexture),
+            InstanceMethod("getCurrentTextureView", &Renderer::getCurrentTextureView),
+            InstanceMethod("swap", &Renderer::swap),
+            InstanceMethod("resize", &Renderer::resize),
+        });
+    }
+
+    Renderer(const Napi::CallbackInfo& info) : Napi::ObjectWrap<Renderer>(info) {
+        const Napi::Env& env = info.Env();
+
+        _device = Napi::Persistent(info[0].As<Napi::Object>());
+        _window = Napi::Persistent(info[1].As<Napi::Object>());
+
+        auto presentMode = wgpuPresentModes.find(info[2].As<Napi::String>().Utf8Value());
+        if (presentMode == wgpuPresentModes.end()) {
+            Napi::Error::New(env, "presentMode argument to Renderer has invalid value").ThrowAsJavaScriptException();
+            return;
+        }
+        _presentMode = presentMode->second;
+
+        if (info[3].IsString()) {
+            _requestedFormatName = info[3].As<Napi::String>().Utf8Value();
+            wgpu::interop::GPUTextureFormat interopFormat;
+            wgpu::binding::Converter convert(env);
+            if (!wgpu::interop::Converter<wgpu::interop::GPUTextureFormat>::FromJS(env, info[3], interopFormat) || !convert(_requestedFormat, interopFormat)) {
+                Napi::Error::New(env, "Unknown texture format \"" + _requestedFormatName + "\"").ThrowAsJavaScriptException();
+                return;
+            }
+            _hasRequestedFormat = true;
+        }
+
+        _requestedUsage = info[4].IsNumber() ? info[4].As<Napi::Number>().Uint32Value() : 0;
+
+        auto* gpuDevice = static_cast<wgpu::binding::GPUDevice*>(wgpu::interop::GPUDevice::Unwrap(_device.Value()));
+        _wgpuDevice = gpuDevice->device_;
+
+        std::weak_ptr<SurfaceState> weakState = _state;
+        gpuDevice->destroy_hooks_.push_back([weakState]() {
+            if (auto state = weakState.lock()) {
+                state->surface = wgpu::Surface();
+                state->destroyed = true;
+            }
+        });
+
+        _adapter = _wgpuDevice.GetAdapter();
+        _instance = _adapter.GetInstance();
+
+        if (!_createSurface(env)) {
+            return;
+        }
+        _configureSurface();
+    }
+
+    Napi::Value getPreferredFormat(const Napi::CallbackInfo& info) {
+        const Napi::Env& env = info.Env();
+
+        wgpu::interop::GPUTextureFormat format;
+        wgpu::binding::Converter convert(env);
+        bool success = convert(format, _format);
+        return success ? wgpu::interop::ToJS(env, format) : env.Null();
+    }
+
+    Napi::Value getCurrentTexture(const Napi::CallbackInfo& info) {
+        const Napi::Env& env = info.Env();
+
+        wgpu::Texture texture = _acquireSurfaceTexture(env);
+        if (!texture) {
+            return env.Undefined();
+        }
+
+        return wgpu::interop::GPUTexture::Create<wgpu::binding::GPUTexture>(env,
+            _wgpuDevice,
+            wgpu::TextureDescriptor(),
+            std::move(texture)
+        );
+    }
+
+    Napi::Value getCurrentTextureView(const Napi::CallbackInfo& info) {
+        const Napi::Env& env = info.Env();
+
+        wgpu::Texture texture = _acquireSurfaceTexture(env);
+        if (!texture) {
+            return env.Undefined();
+        }
+
+        wgpu::TextureView textureView = texture.CreateView();
+
+        return wgpu::interop::GPUTextureView::Create<wgpu::binding::GPUTextureView>(env,
+            wgpu::TextureViewDescriptor(),
+            std::move(textureView)
+        );
+    }
+
+    Napi::Value swap(const Napi::CallbackInfo& info) {
+        const Napi::Env& env = info.Env();
+        if (!_hasSurface(env)) {
+            return env.Undefined();
+        }
+        _state->surface.Present();
+        return env.Undefined();
+    }
+
+    Napi::Value resize(const Napi::CallbackInfo& info) {
+        const Napi::Env& env = info.Env();
+        if (!_hasSurface(env)) {
+            return env.Undefined();
+        }
+        _configureSurface();
+        return env.Undefined();
+    }
+
+private:
+
+    Napi::ObjectReference _device;
+    Napi::ObjectReference _window;
+    wgpu::PresentMode _presentMode;
+    std::string _requestedFormatName;
+    wgpu::TextureFormat _requestedFormat;
+    bool _hasRequestedFormat = false;
+    uint32_t _requestedUsage = 0;
+    wgpu::Device _wgpuDevice;
+    wgpu::Adapter _adapter;
+    wgpu::Instance _instance;
+    struct SurfaceState {
+        wgpu::Surface surface;
+        bool destroyed = false;
+    };
+
+    std::shared_ptr<SurfaceState> _state = std::make_shared<SurfaceState>();
+    wgpu::TextureFormat _format;
+    wgpu::TextureUsage _usage;
+
+    static std::string _formatName(const Napi::Env& env, wgpu::TextureFormat wgpuFormat) {
+        wgpu::interop::GPUTextureFormat format;
+        wgpu::binding::Converter convert(env);
+        if (!convert(format, wgpuFormat)) {
+            return "";
+        }
+        return wgpu::interop::ToJS(env, format).As<Napi::String>().Utf8Value();
+    }
+
+    static bool _statusNeedsReconfigure(wgpu::SurfaceGetCurrentTextureStatus status) {
+        return status == wgpu::SurfaceGetCurrentTextureStatus::Outdated
+            || status == wgpu::SurfaceGetCurrentTextureStatus::Timeout
+            || status == wgpu::SurfaceGetCurrentTextureStatus::Lost;
+    }
+
+    bool _hasSurface(const Napi::Env& env) {
+        if (_state->destroyed || !_state->surface) {
+            Napi::Error::New(env, "The window surface is no longer available because the device was destroyed").ThrowAsJavaScriptException();
+            return false;
+        }
+        if (_window.Get("destroyed").ToBoolean()) {
+            Napi::Error::New(env, "The window surface is no longer available because the window was destroyed").ThrowAsJavaScriptException();
+            return false;
+        }
+        return true;
+    }
+
+    wgpu::Texture _acquireSurfaceTexture(const Napi::Env& env) {
+        if (!_hasSurface(env)) {
+            return wgpu::Texture();
+        }
+
+        wgpu::SurfaceTexture surfaceTexture;
+        _state->surface.GetCurrentTexture(&surfaceTexture);
+
+        if (_statusNeedsReconfigure(surfaceTexture.status)) {
+            _configureSurface();
+            _state->surface.GetCurrentTexture(&surfaceTexture);
+        }
+
+        if (!surfaceTexture.texture) {
+            std::ostringstream message;
+            message << "Failed to get the current texture of the window surface (status " << surfaceTexture.status << ")";
+            Napi::Error::New(env, message.str()).ThrowAsJavaScriptException();
+            return wgpu::Texture();
+        }
+
+        return std::move(surfaceTexture.texture);
+    }
+
+    bool _createSurface(const Napi::Env& env) {
+        Napi::Value jsNative = _window.Get("native");
+        if (env.IsExceptionPending()) {
+            return false;
+        }
+        Napi::Value jsHandle = jsNative.IsObject() ? jsNative.As<Napi::Object>().Get("gpu") : env.Undefined();
+        if (!jsHandle.IsBuffer()) {
+            Napi::Error::New(env, "The window was not created with the { webgpu: true } option").ThrowAsJavaScriptException();
+            return false;
+        }
+
+        _state->surface = wgpu::sdl::CreateSurfaceForWindow(_instance, jsHandle.As<Napi::Buffer<char>>().Data());
+
+        wgpu::SurfaceCapabilities capabilities;
+        _state->surface.GetCapabilities(_adapter, &capabilities);
+
+        if (capabilities.formatCount == 0) {
+            Napi::Error::New(env, "The window surface does not support any texture formats").ThrowAsJavaScriptException();
+            return false;
+        }
+
+        _format = capabilities.formats[0];
+        if (_hasRequestedFormat) {
+            bool found = false;
+            for (size_t i = 0; i < capabilities.formatCount; i++) {
+                if (capabilities.formats[i] == _requestedFormat) {
+                    found = true;
+                    break;
+                }
+            }
+            if (!found) {
+                std::string available;
+                for (size_t i = 0; i < capabilities.formatCount; i++) {
+                    available += (i == 0 ? "" : ", ") + _formatName(env, capabilities.formats[i]);
+                }
+                Napi::Error::New(env, "Format \"" + _requestedFormatName + "\" is not supported by the window surface. Supported formats: " + available).ThrowAsJavaScriptException();
+                return false;
+            }
+            _format = _requestedFormat;
+        }
+
+        _usage = wgpu::TextureUsage::RenderAttachment;
+        if (_requestedUsage != 0) {
+            _usage = static_cast<wgpu::TextureUsage>(_requestedUsage);
+            if (_usage & ~capabilities.usages) {
+                Napi::Error::New(env, "The requested usage is not supported by the window surface").ThrowAsJavaScriptException();
+                return false;
+            }
+        }
+
+        return true;
+    }
+
+    void _configureSurface() {
+        wgpu::SurfaceConfiguration config;
+        config.device = _wgpuDevice;
+        config.format = _format;
+        config.usage = _usage;
+        config.alphaMode = wgpu::CompositeAlphaMode::Opaque;
+        config.width = _window.Get("_pixelWidth").ToNumber().Uint32Value();
+        config.height = _window.Get("_pixelHeight").ToNumber().Uint32Value();
+        config.presentMode = _presentMode;
+        _state->surface.Configure(&config);
+    }
+};
+
+Napi::Value RenderGPUDeviceToWindow(const Napi::FunctionReference& rendererCtor, const Napi::CallbackInfo& info) {
+    const Napi::Env& env = info.Env();
+
+    if (info.Length() != 1) {
+        Napi::Error::New(env, "renderGPUDeviceToWindow expects exactly 1 argument").ThrowAsJavaScriptException();
+        return env.Undefined();
+    }
+    Napi::Value jsArg = info[0];
+
+    if (!jsArg.IsObject()) {
+        Napi::Error::New(env, "argument to renderGPUDeviceToWindow must be an object").ThrowAsJavaScriptException();
+        return env.Undefined();
+    }
+    Napi::Object jsObj = jsArg.ToObject();
+
+    Napi::Value jsDevice = jsObj.Get("device");
+    if (!jsDevice.IsObject()) {
+        Napi::Error::New(env, "device argument to renderGPUDeviceToWindow must be an object").ThrowAsJavaScriptException();
+        return env.Undefined();
+    }
+
+    Napi::Value jsWindow = jsObj.Get("window");
+    if (!jsWindow.IsObject()) {
+        Napi::Error::New(env, "window argument to renderGPUDeviceToWindow must be an object").ThrowAsJavaScriptException();
+        return env.Undefined();
+    }
+
+    Napi::Value jsPresentMode = jsObj.Get("presentMode");
+    if (jsPresentMode.IsUndefined()) {
+        jsPresentMode = Napi::String::New(env, "fifo");
+    } else if (!jsPresentMode.IsString()) {
+        Napi::Error::New(env, "presentMode argument to renderGPUDeviceToWindow must be a string").ThrowAsJavaScriptException();
+        return env.Undefined();
+    } else {
+        std::string presentModeStr = jsPresentMode.As<Napi::String>().Utf8Value();
+        if (wgpuPresentModes.find(presentModeStr) == wgpuPresentModes.end()) {
+            Napi::Error::New(env, "presentMode argument to renderGPUDeviceToWindow has invalid value").ThrowAsJavaScriptException();
+            return env.Undefined();
+        }
+    }
+
+    Napi::Value jsFormat = jsObj.Get("format");
+    if (!jsFormat.IsUndefined() && !jsFormat.IsString()) {
+        Napi::Error::New(env, "format argument to renderGPUDeviceToWindow must be a string").ThrowAsJavaScriptException();
+        return env.Undefined();
+    }
+
+    Napi::Value jsUsage = jsObj.Get("usage");
+    if (!jsUsage.IsUndefined() && !jsUsage.IsNumber()) {
+        Napi::Error::New(env, "usage argument to renderGPUDeviceToWindow must be a number").ThrowAsJavaScriptException();
+        return env.Undefined();
+    }
+
+    return rendererCtor.New({ jsDevice, jsWindow, jsPresentMode, jsFormat, jsUsage });
+}
