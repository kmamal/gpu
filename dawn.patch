+        auto elapsed_ms = std::chrono::duration_cast<std::chrono::milliseconds>(now - self->last_activity_).count();
+        auto delay_ms = elapsed_ms / kProcessEventsBackoffDivisor;
+        if (delay_ms < 1) {
+            delay_ms = 1;
+        } else if (delay_ms > kMaxProcessEventsDelayMs) {
+            delay_ms = kMaxProcessEventsDelayMs;
+        }
+        self->process_events_delay_ms_ = static_cast<uint32_t>(delay_ms);
+        self->ScheduleProcessEvents(env);
+    });
+
+    auto global = env.Global();
+    if (process_events_delay_ms_ == 0) {
+        global.Get("setImmediate").As<Napi::Function>().Call({callback});
+    } else {
+        global.Get("setTimeout").As<Napi::Function>().Call({callback, Napi::Number::New(env, process_events_delay_ms_)});
+    }
 }
 
