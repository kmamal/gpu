@@ -221,6 +221,7 @@ GPUDevice::~GPUDevice() {
     // process, which is not a good idea.
     if (!destroyed_) {
         lost_promise_.Discard();
+        RunDestroyHooks();
         device_.Destroy();
         destroyed_ = true;
     }
@@ -304,10 +305,19 @@ void GPUDevice::destroy(Napi::Env env) {
         lost_promise_.Resolve(interop::GPUDeviceLostInfo::Create<GPUDeviceLostInfo>(
             env_, interop::GPUDeviceLostReason::kDestroyed, "device was destroyed"));
     }
+    RunDestroyHooks();
     device_.Destroy();
     destroyed_ = true;
 }
 
+void GPUDevice::RunDestroyHooks() {
+    std::vector<std::function<void()>> hooks = std::move(destroy_hooks_);
+    destroy_hooks_.clear();
+    for (auto& hook : hooks) {
+        hook();
+    }
+}
